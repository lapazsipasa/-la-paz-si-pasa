#!/bin/bash
# El PHP de wp eval va entre comillas simples a propósito: sus $ no son del shell.
# shellcheck disable=SC2016
set -euo pipefail

# Uso: lapaz-setup [--seed [--forzar-seed]]   (--seed carga además el contenido inicial de /opt/seed)
cargar_seed=false
forzar_seed=false
for arg in "$@"; do
    case "$arg" in
        --seed) cargar_seed=true ;;
        --forzar-seed) forzar_seed=true ;;
        *)
            printf 'ERROR: opción desconocida: %s\nUso: lapaz-setup [--seed [--forzar-seed]]\n' "$arg" >&2
            exit 2
            ;;
    esac
done

: "${WORDPRESS_URL:?Define WORDPRESS_URL}"
wp=(wp --path=/var/www/html)

# Guarda: --seed sobre un sitio ya instalado en producción pisaría contenido editado a mano.
# WordPress y compose.yaml toman «production» cuando la variable no está definida; aquí igual.
if "${wp[@]}" core is-installed 2>/dev/null; then ya_instalado=true; else ya_instalado=false; fi
if [ "$cargar_seed" = true ] && [ "$forzar_seed" = false ] && [ "$ya_instalado" = true ] \
    && [ "${WP_ENVIRONMENT_TYPE:-production}" = production ]; then
    cat >&2 <<'MSG'
ERROR: --seed se rechaza: el sitio ya está instalado y WP_ENVIRONMENT_TYPE es production.
El seed pisa retratos, videos, ferias, subcuentas y audios cuyo título coincida con contenido.json.
Alternativa (una sola sección: productores, boletines o historias):
SEED_SOLO=productores wp --path=/var/www/html eval-file /opt/seed/seed.php
Si de verdad quieres cargar todo el seed: lapaz-setup --seed --forzar-seed
MSG
    exit 1
fi

if [ "$ya_instalado" = false ]; then
    : "${WP_ADMIN_EMAIL:?Define WP_ADMIN_EMAIL}"
    admin_password="$(openssl rand -base64 18)"
    # La contraseña pasa por stdin para que no aparezca en los argumentos del proceso.
    printf '%s\n' "$admin_password" | "${wp[@]}" core install \
        --url="$WORDPRESS_URL" \
        --title="La Paz Sí Pasa" \
        --admin_user="${WP_ADMIN_USER:-admin}" \
        --admin_email="$WP_ADMIN_EMAIL" \
        --prompt=admin_password \
        --skip-email
    printf 'Guarda esta contraseña de administrador; se muestra una sola vez: %s\n' "$admin_password"
    unset admin_password
fi

if ! "${wp[@]}" language core install es_CO --activate; then
    "${wp[@]}" language core install es_ES --activate
fi
"${wp[@]}" theme activate lapaz
"${wp[@]}" plugin activate secure-custom-fields   # sin SCF no hay CPT: si falla, se aborta

# SEO (The SEO Framework): si no se activa, el sitio sigue con el SEO de respaldo del tema (inc/seo.php).
if "${wp[@]}" plugin activate autodescription; then seo_tsf=true; else
    seo_tsf=false
    echo "Aviso: no se pudo activar autodescription; el sitio usa el SEO de respaldo del tema." >&2
fi
# Ajustes iniciales y migración, una sola vez para no pisar lo que un administrador cambie después.
# El noindex fuera de producción lo pone el tema, no el plugin.
if [ "$seo_tsf" = true ] && [ -z "$("${wp[@]}" option get lapaz_seo_configurado 2>/dev/null || true)" ]; then
    # update_option( array ) fusiona con lo guardado o con los valores por defecto (plugin.class.php de TSF 5.2.1).
    "${wp[@]}" eval '
        \The_SEO_Framework\Data\Plugin::update_option( array(
            "title_separator"        => "pipe",
            "homepage_title_tagline" => "Fondo Colombia en Paz",
            "ld_json_searchbox"      => 0,
            "knowledge_name"         => "Fondo Colombia en Paz",
        ) );
        // Extracto de las páginas -> descripción del plugin, sin pisar una que ya exista.
        foreach ( get_posts( array( "post_type" => "page", "post_status" => "any", "numberposts" => -1 ) ) as $p ) {
            if ( "" !== $p->post_excerpt && "" === (string) get_post_meta( $p->ID, "_genesis_description", true ) ) {
                update_post_meta( $p->ID, "_genesis_description", $p->post_excerpt );
            }
        }
    '
    "${wp[@]}" option update lapaz_seo_configurado 1
fi

# Contenido de ejemplo de una instalación nueva: no es parte del sitio y entraría al sitemap.
# Los nombres cambian con el idioma del instalador: en español son hola-mundo y pagina-ejemplo.
for slug in hello-world sample-page hola-mundo pagina-ejemplo; do
    for id in $("${wp[@]}" post list --post_type=post,page --name="$slug" --post_status=any --format=ids); do
        "${wp[@]}" post delete "$id" --force
    done
done

# Plugins y temas que trae la imagen y el sitio no usa (AI es experimental). Se borran:
# desactivados igual quedan en el disco, se actualizan y amplían la superficie de ataque.
for plugin in ai ai-provider-for-anthropic ai-provider-for-google hello akismet; do
    if "${wp[@]}" plugin is-installed "$plugin" 2>/dev/null; then
        "${wp[@]}" plugin deactivate "$plugin" 2>/dev/null || true
        "${wp[@]}" plugin delete "$plugin"
    fi
done
for tema in $("${wp[@]}" theme list --status=inactive --field=name); do
    "${wp[@]}" theme delete "$tema"
done

# Sin comentarios ni pingbacks por defecto en contenido nuevo.
"${wp[@]}" option update default_comment_status closed
"${wp[@]}" option update default_ping_status closed
"${wp[@]}" rewrite structure '/%postname%/' --hard
# Verificación: si .htaccess quedó sin reglas, todas las páginas darían 404 de Apache.
grep -q "RewriteRule" /var/www/html/.htaccess || { echo "ERROR: .htaccess sin reglas de reescritura" >&2; exit 1; }

# Portada: la página Inicio (slug home) guarda los campos de group_home, como lee Astro.
home_id="$("${wp[@]}" post list --post_type=page --name=home --post_status=any --format=ids)"
if [ -z "$home_id" ]; then
    home_id="$("${wp[@]}" post create --post_type=page --post_name=home --post_title=Inicio --post_status=publish --porcelain)"
fi
"${wp[@]}" option update show_on_front page
"${wp[@]}" option update page_on_front "$home_id"

page_id="$("${wp[@]}" post list --post_type=page --name=proyectos-destacados --post_status=any --format=ids)"
if [ -z "$page_id" ]; then
    page_id="$("${wp[@]}" post create --post_type=page --post_name=proyectos-destacados \
        --post_title="Proyectos destacados" --post_status=publish --porcelain)"
fi

# Catálogo PaisSana: la plantilla page-productores.html pinta la página con slug «productores».
# Migración: la página se llamó «paissana»; se renombra conservando su ID, sin duplicarla.
productores_id="$("${wp[@]}" post list --post_type=page --name=productores --post_status=any --format=ids)"
paissana_id="$("${wp[@]}" post list --post_type=page --name=paissana --post_status=any --format=ids)"
if [ -z "$productores_id" ] && [ -n "$paissana_id" ]; then
    "${wp[@]}" post update "$paissana_id" --post_name=productores --post_title="Productores PaisSana" --post_status=publish
elif [ -z "$productores_id" ]; then
    "${wp[@]}" post create --post_type=page --post_name=productores \
        --post_title="Productores PaisSana" --post_status=publish
fi
if [ -n "$productores_id" ] && [ -n "$paissana_id" ]; then
    echo "Aviso: existen las páginas «paissana» y «productores»; no se borra nada, revisa «paissana» a mano." >&2
fi

# Menú principal. Proyectos destacados es un enlace de página (id): sin 301 y con estado activo.
nav_nuevo='<!-- wp:navigation-link {"label":"Lo que hacemos","url":"/#lo-que-hacemos","kind":"custom"} /-->
<!-- wp:navigation-link {"label":"Actualidad","url":"/#actualidad","kind":"custom"} /-->
<!-- wp:navigation-link {"label":"Proyectos destacados","type":"page","id":'"$page_id"',"kind":"post-type","url":"/proyectos-destacados/"} /-->
<!-- wp:navigation-link {"label":"Boletín","url":"/boletin/","kind":"custom"} /-->'
# Contenidos de fábrica anteriores: los 3 enlaces originales, con y sin «Boletín» al final.
nav_viejo='<!-- wp:navigation-link {"label":"Lo que hacemos","url":"/#lo-que-hacemos","kind":"custom"} /-->
<!-- wp:navigation-link {"label":"Proyectos destacados","url":"/proyectos-destacados","kind":"custom"} /-->
<!-- wp:navigation-link {"label":"Actualidad","url":"/#actualidad","kind":"custom"} /-->'
nav_viejo_boletin="$nav_viejo
<!-- wp:navigation-link {\"label\":\"Boletín\",\"url\":\"/boletin/\",\"kind\":\"custom\"} /-->"

nav_id="$("${wp[@]}" option get lapaz_nav_ref 2>/dev/null || true)"
if [[ ! "$nav_id" =~ ^[1-9][0-9]*$ ]] || [ "$("${wp[@]}" post get "$nav_id" --field=post_type 2>/dev/null || true)" != wp_navigation ]; then
    nav_id="$("${wp[@]}" post create --post_type=wp_navigation --post_title=Principal \
        --post_status=publish --post_content="$nav_nuevo" --porcelain)"
    "${wp[@]}" option update lapaz_nav_ref "$nav_id"
else
    # Migración: solo si el menú sigue siendo uno de fábrica; si el editor lo cambió, no se toca.
    nav_actual="$("${wp[@]}" post get "$nav_id" --field=post_content)"
    if [ "$nav_actual" = "$nav_viejo" ] || [ "$nav_actual" = "$nav_viejo_boletin" ]; then
        "${wp[@]}" post update "$nav_id" --post_content="$nav_nuevo"
    elif [ "$nav_actual" != "$nav_nuevo" ]; then
        echo "Aviso: el menú Principal fue editado; no se reordenó. Orden recomendado: Lo que hacemos, Actualidad, Proyectos destacados (enlace de página), Boletín." >&2
    fi
fi

if [ "${WP_ENVIRONMENT_TYPE:-production}" = local ]; then
    # Guía de estilos viva (bloque lapaz/guia-estilos): solo existe en local.
    if [ -z "$("${wp[@]}" post list --post_type=page --name=guia-de-estilos --post_status=any --format=ids)" ]; then
        "${wp[@]}" post create --post_type=page --post_name=guia-de-estilos \
            --post_title="Guía de estilos" --post_status=publish
    fi
    for plugin in query-monitor create-block-theme; do
        if ! "${wp[@]}" plugin is-installed "$plugin"; then
            "${wp[@]}" plugin install "$plugin"
        fi
        "${wp[@]}" plugin activate "$plugin"
    done
fi

# Caché de página: solo con WP_CACHE=true (Dokploy). Modo simple (PHP), sin tocar .htaccess;
# no cachea a usuarios con sesión; se vacía sola al guardar contenido.
if [ "${WP_CACHE:-}" = true ]; then
    "${wp[@]}" plugin activate wp-super-cache
    "${wp[@]}" eval '
        wp_cache_verify_config_file();
        wp_cache_create_advanced_cache();
        wp_cache_enable();
        wp_super_cache_enable();
        wp_cache_setting( "wp_cache_mod_rewrite", 0 );
        wp_cache_setting( "wp_cache_not_logged_in", 2 );
        // Los enlaces terminan en «/» (/%postname%/). Sin esto solo se servía la portada desde
        // caché: el plugin lo ajusta al guardar su panel, que aquí no se usa.
        wp_cache_setting( "wp_cache_slash_check", 1 );
        // /productores/ con cualquier parámetro (?buscar=, ?ver=, ?x=…) no se guarda en caché: cualquiera
        // podría llenar el disco con URLs inventadas. /productores/ limpia sí. El plugin evalúa cada
        // expresión con preg_match("~expr~") contra la URI pedida, con la query incluida. Los dos
        // primeros son los de fábrica. /sitemap* y /wp-sitemap* (sitemap.xml del plugin) tampoco se guarda: debe estar al día.
        wp_cache_setting( "cache_rejected_uri", array( "wp-.*\\.php", "index\\.php", "^/productores/.*\\?", "^/(wp-)?sitemap" ) );
        echo "Caché de página: activa\n";
    '
elif "${wp[@]}" plugin is-active wp-super-cache 2>/dev/null; then
    "${wp[@]}" plugin deactivate wp-super-cache
fi

if [ "$cargar_seed" = true ]; then
    # Por secciones: en el servidor una sola corrida larga puede cortarse por tiempo.
    for seccion in retratos videos ferias audio_relatos subcuentas productores boletines historias; do
        SEED_SOLO="$seccion" "${wp[@]}" eval-file /opt/seed/seed.php
    done
fi

# Plantillas guardadas en la base: tapan en silencio los archivos del tema. Solo se avisa y solo
# cuentan las publicadas del tema lapaz; un fallo aquí no aborta el script (falta vaciar la caché).
if plantillas="$("${wp[@]}" eval '
    foreach ( get_posts( array(
        "post_type"   => array( "wp_template", "wp_template_part" ),
        "post_status" => "publish",
        "numberposts" => -1,
        "tax_query"   => array( array( "taxonomy" => "wp_theme", "field" => "name", "terms" => "lapaz" ) ),
    ) ) as $p ) {
        echo $p->post_type . "," . $p->post_name . "\n";
    }' 2>/dev/null)"; then
    if [ -n "$plantillas" ]; then
        echo "Aviso: hay plantillas personalizadas en la base; tapan los archivos del tema (tipo,nombre):" >&2
        echo "$plantillas" >&2
        echo "Revísalas en Editor del sitio → Plantillas → Gestionar → restablecer (Clear customizations)." >&2
    fi
else
    echo "Aviso: no se pudo comprobar si hay plantillas personalizadas en la base." >&2
fi

# El sitemap del plugin se guarda en transitorios: se vacía al final, con páginas y seed ya creados.
if [ "$seo_tsf" = true ]; then
    "${wp[@]}" eval 'if ( class_exists( "\\The_SEO_Framework\\Sitemap\\Cache" ) ) { \The_SEO_Framework\Sitemap\Cache::clear_sitemap_caches(); }' \
        || echo "Aviso: no se pudo vaciar la caché del sitemap." >&2
fi

# Tras un despliegue el volumen conserva las páginas guardadas de la versión anterior.
if [ "${WP_CACHE:-}" = true ]; then
    "${wp[@]}" eval '
        if ( ! function_exists( "wp_cache_clear_cache" ) ) {
            fwrite( STDERR, "Aviso: wp_cache_clear_cache() no está disponible; caché de página no vaciada.\n" );
            return;
        }
        $dir = WP_CONTENT_DIR . "/cache";
        if ( is_dir( $dir ) && ! is_writable( $dir ) ) {
            fwrite( STDERR, "Aviso: $dir no es escribible por www-data; la caché de página no se vació.\n" );
            return;
        }
        wp_cache_clear_cache();
        echo "Caché de página: vaciada\n";
    '
fi

printf '\nURL: %s\nTema activo: %s\nID del menú: %s\n' \
    "$WORDPRESS_URL" "$("${wp[@]}" option get stylesheet)" "$nav_id"
