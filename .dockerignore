.git
.gitignore
.gitattributes
.vscode
.DS_Store

# rebuilt inside the image, never copy from the host
**/node_modules/
**/dist/
**/.astro/

# not needed by any build stage
docs/
skills/
apps/frontend/documentacion/
compose.yaml
README.md
.env
.env.*
!.env.example

# fuente, documentación, pruebas y dependencias de desarrollo: ninguna imagen las copia
raw/
wiki/
apps/wp-fse/vendor/
apps/wp-fse/tests/
# credenciales locales (también ignoradas por git): nunca al contexto de build
credenciales*.txt
